# --- API ---
SYNTH_API_KEY=replace_me_synthdata_pro_key
SYNTH_BASE_URL=https://api.synthdata.co
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# --- Mode ---
PAPER_TRADE_MODE=true
ENABLE_LIVE_TRADING=false
ALLOW_MARKETABLE_ORDERS=false

# --- Bankroll & sizing ---
BANKROLL_USD=1000
MAX_POSITION_SIZE=0.01
MAX_TOTAL_EXPOSURE=0.25
MAX_ASSET_EXPOSURE=0.10
MAX_HORIZON_EXPOSURE=0.15
MAX_TRADES_PER_SCAN=2
MAX_OPEN_POSITIONS=5
MAX_OPEN_POSITIONS_PER_ASSET=2
MAX_OPEN_POSITIONS_PER_HORIZON=3
POSITION_COOLDOWN_SECONDS=300
KELLY_FRACTION=0.25
MAX_KELLY_FRACTION=0.25

# --- Edge ---
MIN_ENTRY_EDGE=0.06
MIN_EXIT_EDGE=0.015
MIN_CONFIDENCE_SCORE=0.50

# --- Filters ---
MAX_SPREAD=0.05
MIN_LIQUIDITY_USD=500
MIN_VOLUME=1000
MIN_HOURS_TO_RES=0
MAX_ENTRY_AGE_15M_SEC=180
MAX_ENTRY_AGE_1H_SEC=600
MIN_SECONDS_TO_EVENT_END=180
ASSUMED_SLIPPAGE_BPS=50
MAKER_FEE_BPS=0
TAKER_FEE_BPS=0
BACKTEST_PARTIAL_FILL_RATIO=1.0
ALLOWED_CATEGORIES=crypto

# Synth assets and forecast horizons (seconds: 900=15M, 3600=1H)
SYNTH_ASSETS=BTC,ETH,SOL,HYPE
SYNTH_HORIZONS_SEC=900,3600

# API spend controls
SYNTH_CACHE_ENABLED=true
SYNTH_LIVE_CACHE_TTL_SEC=60
SYNTH_HISTORICAL_CACHE_TTL_SEC=604800
MAX_BACKTEST_CALLS_WITHOUT_CONFIRM=500
REQUIRE_REAL_TWO_SIDED_CLOB=true
ALLOW_COMPLEMENTARY_BOOK_FALLBACK=false
MAX_SYNTH_STALENESS_SEC=90
MAX_CLOB_STALENESS_SEC=30
MAX_BACKTEST_SNAPSHOT_LAG_SEC=90
ALLOW_CURRENT_OUTCOME_BACKTEST_LABEL=false

# Calibration and segment risk
CALIBRATION_DB_PATH=polybot/data/calibration/observations.jsonl
CALIBRATION_REPORT_DIR=polybot/logs/calibration
CALIBRATION_BINS=10
MIN_CALIBRATION_SAMPLES_SEGMENT=100
MIN_CALIBRATION_SAMPLES_GLOBAL=300
CALIBRATION_SHRINKAGE_K=200
CONFIDENCE_MIN_SAMPLES=50
MODEL_CONFIDENCE_FLOOR=0.25
MAX_CONFIDENCE_POSITION_MULTIPLIER=1.5
SEGMENT_DISABLE_MIN_SAMPLES=50
SEGMENT_DISABLE_SHARPE_BELOW=0

# Exit rules
TAKE_PROFIT_EDGE_COLLAPSE=0.02
MODEL_REVERSAL_EXIT=true
TIME_STOP_SECONDS=120

# Local reports
REPORT_TIMEZONE=America/New_York
REPORT_DIR=polybot/logs/reports
SNAPSHOT_DB_PATH=polybot/data/snapshots.sqlite3
POSITIONS_PATH=polybot/logs/positions.jsonl
